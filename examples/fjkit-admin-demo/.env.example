# Copy to .env to change any of these. Every one has a default in
# admin_demo/config.py, so the demo runs with no .env at all.

# Defaults to admin-demo.sqlite next to the package, created on first start.
# FJKIT_ADMIN_DEMO_DATABASE_URL=sqlite:///./admin-demo.sqlite

# What the admin calls itself, and the link back out of it.
FJKIT_ADMIN_DEMO_TITLE=Board admin
FJKIT_ADMIN_DEMO_HOME_URL=/
FJKIT_ADMIN_DEMO_HOME_LABEL=Back to the board

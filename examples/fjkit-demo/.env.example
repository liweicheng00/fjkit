# Copy to .env to change any of these. Every one has a default in app/config.py,
# so the demo runs with no .env at all.

# Signs the flash and session cookies. Fixed in the demo so a reload during
# `fastapi dev` keeps the session that was signed in. A real app generates one.
FJKIT_DEMO_SECRET=fjkit-demo-not-a-secret

# The single demo account, prefilled in the sign-in form.
FJKIT_DEMO_USERNAME=ada
FJKIT_DEMO_PASSWORD=lovelace

# False because the demo is served over plain HTTP on localhost.
FJKIT_DEMO_COOKIE_SECURE=false
